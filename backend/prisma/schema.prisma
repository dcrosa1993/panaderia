// Draft v1 — reviewed conceptual model for the Panadería Costing Platform.
// Prisma ORM v7 style. No migrations have been generated or applied yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum MembershipRole {
  ADMIN
  EDITOR
  VIEWER
}

enum BakeryStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TaxpayerType {
  TCP
  MIPYME
  NON_AGRICULTURAL_COOPERATIVE
  OTHER
  UNCONFIRMED
}

enum MeasurementDimension {
  MASS
  VOLUME
  COUNT
  TIME
  LENGTH
  AREA
  ENERGY
  OTHER
}

enum MaterialKind {
  INGREDIENT
  PACKAGING
  CONSUMABLE
  FUEL
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RecipeVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OverheadCategory {
  ELECTRICITY
  WATER
  FUEL
  RENT
  MAINTENANCE
  DEPRECIATION
  TRANSPORT
  TELECOMMUNICATIONS
  OTHER
}

enum AllocationMethod {
  LABOR_HOURS
  BATCHES
  OUTPUT_QUANTITY
  DIRECT_COST_PROPORTION
}

enum TaxCategory {
  SALES
  PROFIT_OR_INCOME
  LABOR
  PURCHASE
  OTHER
}

enum TaxCalculationMethod {
  PERCENT_OF_BASE
  FIXED_AMOUNT
  PROGRESSIVE_BRACKETS
  EXEMPTION
}

enum TaxBase {
  NET_SALES
  PROFIT_BEFORE_PROFIT_TAX
  GROSS_SALES
  LABOR_REMUNERATION
  TAXABLE_INCOME
  PURCHASE_VALUE
  OTHER
}

enum TaxRuleVerificationStatus {
  PENDING_VALIDATION
  VERIFIED
  REJECTED
  RETIRED
}

enum CostCalculationStatus {
  COMPLETE
  INCOMPLETE
  FAILED
}

enum CalculationLineType {
  MATERIAL
  LABOR
  OVERHEAD
  ADJUSTMENT
}

enum PriceTaxTreatment {
  TAX_EXCLUDED_FROM_PRICE
  TAX_INCLUDED_IN_PRICE
  NOT_CONFIGURED
}

enum PriceScenarioStatus {
  DRAFT
  CALCULATED
  INCOMPLETE
  FAILED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  emailNormalized String     @unique @db.VarChar(320)
  passwordHash    String     @db.VarChar(255)
  displayName     String     @db.VarChar(160)
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  memberships         Membership[]
  createdCalculations CostCalculation[] @relation("CalculationCreatedBy")

  @@index([status])
}

model Bakery {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(180)
  status    BakeryStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)

  memberships           Membership[]
  fiscalProfileVersions FiscalProfileVersion[]
  materials             Material[]
  products              Product[]
  laborRoles            LaborRole[]
  overheadExpenses      OverheadExpense[]
  taxAssignments        BakeryTaxRule[]
  costCalculations      CostCalculation[]
  priceScenarios        PriceScenario[]

  @@index([status, name])
}

model Membership {
  userId    String         @db.Uuid
  bakeryId  String         @db.Uuid
  role      MembershipRole @default(VIEWER)
  status    UserStatus     @default(ACTIVE)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bakery Bakery @relation(fields: [bakeryId], references: [id], onDelete: Cascade)

  @@id([userId, bakeryId])
  @@index([bakeryId, role, status])
}

model FiscalProfileVersion {
  id           String       @id @default(uuid()) @db.Uuid
  bakeryId     String       @db.Uuid
  taxpayerType TaxpayerType @default(UNCONFIRMED)
  taxId        String?      @db.VarChar(64)
  activityCode String?      @db.VarChar(64)
  legalName    String?      @db.VarChar(240)
  province     String?      @db.VarChar(120)
  municipality String?      @db.VarChar(120)
  validFrom    DateTime     @db.Date
  validTo      DateTime?    @db.Date
  notes        String?      @db.Text
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)

  bakery Bakery @relation(fields: [bakeryId], references: [id], onDelete: Restrict)

  @@unique([id, bakeryId])
  @@index([bakeryId, validFrom])
}

model MeasurementUnit {
  id               String               @id @default(uuid()) @db.Uuid
  code             String               @unique @db.VarChar(32)
  name             String               @db.VarChar(100)
  dimension        MeasurementDimension
  conversionFactor Decimal              @db.Decimal(20, 10)
  isCanonical      Boolean              @default(false)
  isActive         Boolean              @default(true)

  materials          Material[]        @relation("MaterialBaseUnit")
  materialPackages   MaterialPrice[]   @relation("MaterialPackageUnit")
  products           Product[]         @relation("ProductSalesUnit")
  recipeOutputs      RecipeVersion[]   @relation("RecipeOutputUnit")
  recipeMaterials    RecipeMaterial[]  @relation("RecipeMaterialUnit")
  overheadAllocation OverheadExpense[] @relation("OverheadAllocationUnit")

  @@index([dimension, isActive])
}

model Material {
  id               String       @id @default(uuid()) @db.Uuid
  bakeryId         String       @db.Uuid
  name             String       @db.VarChar(180)
  kind             MaterialKind @default(INGREDIENT)
  baseUnitId       String       @db.Uuid
  // Optional material density, in grams per millilitre, for validated mass/volume conversion.
  densityGramPerMl Decimal?     @db.Decimal(18, 8)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)

  bakery      Bakery           @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  baseUnit    MeasurementUnit  @relation("MaterialBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  prices      MaterialPrice[]
  recipeLines RecipeMaterial[]

  @@unique([id, bakeryId])
  @@unique([bakeryId, name])
  @@index([bakeryId, isActive, name])
}

model MaterialPrice {
  id              String    @id @default(uuid()) @db.Uuid
  bakeryId        String    @db.Uuid
  materialId      String    @db.Uuid
  packagePriceCUP Decimal   @db.Decimal(18, 2)
  packageQuantity Decimal   @db.Decimal(18, 6)
  packageUnitId   String    @db.Uuid
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  sourceNote      String?   @db.VarChar(500)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  material    Material        @relation(fields: [materialId, bakeryId], references: [id, bakeryId], onDelete: Restrict)
  packageUnit MeasurementUnit @relation("MaterialPackageUnit", fields: [packageUnitId], references: [id], onDelete: Restrict)

  @@unique([id, bakeryId])
  @@unique([bakeryId, materialId, effectiveFrom])
  @@index([bakeryId, materialId, effectiveFrom])
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  bakeryId    String        @db.Uuid
  name        String        @db.VarChar(180)
  description String?       @db.Text
  salesUnitId String        @db.Uuid
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  bakery         Bakery            @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  salesUnit      MeasurementUnit   @relation("ProductSalesUnit", fields: [salesUnitId], references: [id], onDelete: Restrict)
  recipeVersions RecipeVersion[]
  calculations   CostCalculation[]

  @@unique([id, bakeryId])
  @@unique([bakeryId, name])
  @@index([bakeryId, status, name])
}

model RecipeVersion {
  id               String              @id @default(uuid()) @db.Uuid
  bakeryId         String              @db.Uuid
  productId        String              @db.Uuid
  versionNumber    Int
  status           RecipeVersionStatus @default(DRAFT)
  outputQuantity   Decimal             @db.Decimal(18, 6)
  outputUnitId     String              @db.Uuid
  effectiveFrom    DateTime?           @db.Date
  effectiveTo      DateTime?           @db.Date
  preparationNotes String?             @db.Text
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(6)

  product         Product                @relation(fields: [productId, bakeryId], references: [id, bakeryId], onDelete: Restrict)
  outputUnit      MeasurementUnit        @relation("RecipeOutputUnit", fields: [outputUnitId], references: [id], onDelete: Restrict)
  materials       RecipeMaterial[]
  laborOperations RecipeLaborOperation[]
  calculations    CostCalculation[]

  @@unique([id, bakeryId])
  @@unique([bakeryId, productId, versionNumber])
  @@index([bakeryId, productId, status])
}

model RecipeMaterial {
  id              String  @id @default(uuid()) @db.Uuid
  bakeryId        String  @db.Uuid
  recipeVersionId String  @db.Uuid
  materialId      String  @db.Uuid
  quantity        Decimal @db.Decimal(18, 6)
  unitId          String  @db.Uuid
  position        Int     @default(0)
  notes           String? @db.VarChar(500)

  recipeVersion RecipeVersion   @relation(fields: [recipeVersionId, bakeryId], references: [id, bakeryId], onDelete: Restrict)
  material      Material        @relation(fields: [materialId, bakeryId], references: [id, bakeryId], onDelete: Restrict)
  unit          MeasurementUnit @relation("RecipeMaterialUnit", fields: [unitId], references: [id], onDelete: Restrict)

  @@index([bakeryId, recipeVersionId, position])
  @@index([bakeryId, materialId])
}

model LaborRole {
  id        String   @id @default(uuid()) @db.Uuid
  bakeryId  String   @db.Uuid
  name      String   @db.VarChar(140)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  bakery     Bakery                 @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  rates      LaborRate[]
  operations RecipeLaborOperation[]

  @@unique([id, bakeryId])
  @@unique([bakeryId, name])
  @@index([bakeryId, isActive])
}

model LaborRate {
  id            String    @id @default(uuid()) @db.Uuid
  bakeryId      String    @db.Uuid
  laborRoleId   String    @db.Uuid
  hourlyRateCUP Decimal   @db.Decimal(18, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  notes         String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  laborRole LaborRole @relation(fields: [laborRoleId, bakeryId], references: [id, bakeryId], onDelete: Restrict)

  @@unique([id, bakeryId])
  @@unique([bakeryId, laborRoleId, effectiveFrom])
  @@index([bakeryId, laborRoleId, effectiveFrom])
}

model RecipeLaborOperation {
  id              String  @id @default(uuid()) @db.Uuid
  bakeryId        String  @db.Uuid
  recipeVersionId String  @db.Uuid
  laborRoleId     String  @db.Uuid
  operationName   String  @db.VarChar(160)
  durationMinutes Decimal @db.Decimal(12, 4)
  workersCount    Decimal @default(1) @db.Decimal(10, 3)
  position        Int     @default(0)
  notes           String? @db.VarChar(500)

  recipeVersion RecipeVersion @relation(fields: [recipeVersionId, bakeryId], references: [id, bakeryId], onDelete: Restrict)
  laborRole     LaborRole     @relation(fields: [laborRoleId, bakeryId], references: [id, bakeryId], onDelete: Restrict)

  @@index([bakeryId, recipeVersionId, position])
}

model OverheadExpense {
  id                     String           @id @default(uuid()) @db.Uuid
  bakeryId               String           @db.Uuid
  name                   String           @db.VarChar(180)
  category               OverheadCategory @default(OTHER)
  amountCUP              Decimal          @db.Decimal(18, 2)
  periodStart            DateTime         @db.Date
  periodEnd              DateTime         @db.Date
  allocationMethod       AllocationMethod
  allocationBaseQuantity Decimal?         @db.Decimal(18, 6)
  allocationUnitId       String?          @db.Uuid
  notes                  String?          @db.Text
  createdAt              DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(6)

  bakery         Bakery           @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  allocationUnit MeasurementUnit? @relation("OverheadAllocationUnit", fields: [allocationUnitId], references: [id], onDelete: Restrict)

  @@unique([id, bakeryId])
  @@index([bakeryId, periodStart, periodEnd])
  @@index([bakeryId, category])
}

model TaxRule {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique @db.VarChar(80)
  name      String      @db.VarChar(180)
  category  TaxCategory
  isSystem  Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  versions          TaxRuleVersion[]
  bakeryAssignments BakeryTaxRule[]
}

model TaxRuleVersion {
  id                 String                    @id @default(uuid()) @db.Uuid
  taxRuleId          String                    @db.Uuid
  versionNumber      Int
  calculationMethod  TaxCalculationMethod
  taxBase            TaxBase
  rate               Decimal?                  @db.Decimal(9, 6)
  fixedAmountCUP     Decimal?                  @db.Decimal(18, 2)
  effectiveFrom      DateTime?                 @db.Date
  effectiveTo        DateTime?                 @db.Date
  verificationStatus TaxRuleVerificationStatus @default(PENDING_VALIDATION)
  legalReference     String?                   @db.VarChar(500)
  notes              String?                   @db.Text
  createdAt          DateTime                  @default(now()) @db.Timestamptz(6)

  taxRule     TaxRule         @relation(fields: [taxRuleId], references: [id], onDelete: Restrict)
  brackets    TaxBracket[]
  assignments BakeryTaxRule[]

  @@unique([taxRuleId, versionNumber])
  @@unique([id, taxRuleId])
  @@index([taxRuleId, verificationStatus, effectiveFrom])
}

model TaxBracket {
  id                String   @id @default(uuid()) @db.Uuid
  taxRuleVersionId  String   @db.Uuid
  lowerBoundCUP     Decimal  @db.Decimal(18, 2)
  upperBoundCUP     Decimal? @db.Decimal(18, 2)
  marginalRate      Decimal  @db.Decimal(9, 6)
  fixedDeductionCUP Decimal  @default(0) @db.Decimal(18, 2)

  taxRuleVersion TaxRuleVersion @relation(fields: [taxRuleVersionId], references: [id], onDelete: Cascade)

  @@unique([taxRuleVersionId, lowerBoundCUP])
  @@index([taxRuleVersionId, lowerBoundCUP])
}

// `enabled` means enabled for simulations. `verificationStatus` on the linked
// version still controls the legal-validation warning shown in the UI.
model BakeryTaxRule {
  id                 String    @id @default(uuid()) @db.Uuid
  bakeryId           String    @db.Uuid
  taxRuleId          String    @db.Uuid
  taxRuleVersionId   String    @db.Uuid
  enabled            Boolean   @default(false)
  effectiveFrom      DateTime? @db.Date
  effectiveTo        DateTime? @db.Date
  configurationNotes String?   @db.Text
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)

  bakery         Bakery            @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  taxRule        TaxRule           @relation(fields: [taxRuleId], references: [id], onDelete: Restrict)
  taxRuleVersion TaxRuleVersion    @relation(fields: [taxRuleVersionId, taxRuleId], references: [id, taxRuleId], onDelete: Restrict)
  scenarioLines  ScenarioTaxLine[]

  @@unique([id, bakeryId])
  @@unique([id, bakeryId, taxRuleVersionId])
  @@unique([bakeryId, taxRuleId, effectiveFrom])
  @@index([bakeryId, enabled, effectiveFrom])
}

model CostCalculation {
  id                     String                @id @default(uuid()) @db.Uuid
  bakeryId               String                @db.Uuid
  productId              String                @db.Uuid
  recipeVersionId        String                @db.Uuid
  createdByUserId        String?               @db.Uuid
  valuationDate          DateTime              @db.Date
  status                 CostCalculationStatus @default(INCOMPLETE)
  materialCostCUP        Decimal?              @db.Decimal(18, 2)
  laborCostCUP           Decimal?              @db.Decimal(18, 2)
  overheadCostCUP        Decimal?              @db.Decimal(18, 2)
  totalProductionCostCUP Decimal?              @db.Decimal(18, 2)
  outputQuantity         Decimal?              @db.Decimal(18, 6)
  outputUnitSnapshot     String?               @db.VarChar(32)
  unitCostCUP            Decimal?              @db.Decimal(18, 6)
  incompleteReasons      Json?
  inputSnapshot          Json
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)

  bakery        Bakery            @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  product       Product           @relation(fields: [productId, bakeryId], references: [id, bakeryId], onDelete: Restrict)
  recipeVersion RecipeVersion     @relation(fields: [recipeVersionId, bakeryId], references: [id, bakeryId], onDelete: Restrict)
  createdBy     User?             @relation("CalculationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines         CalculationLine[]
  scenarios     PriceScenario[]

  @@unique([id, bakeryId])
  @@index([bakeryId, productId, valuationDate])
  @@index([bakeryId, status, createdAt])
}

model CalculationLine {
  id                  String              @id @default(uuid()) @db.Uuid
  bakeryId            String              @db.Uuid
  calculationId       String              @db.Uuid
  lineType            CalculationLineType
  descriptionSnapshot String              @db.VarChar(240)
  quantity            Decimal?            @db.Decimal(18, 6)
  unitNameSnapshot    String?             @db.VarChar(32)
  unitCostCUP         Decimal?            @db.Decimal(18, 6)
  totalCUP            Decimal?            @db.Decimal(18, 2)
  detailsSnapshot     Json?

  calculation CostCalculation @relation(fields: [calculationId, bakeryId], references: [id, bakeryId], onDelete: Restrict)

  @@index([bakeryId, calculationId, lineType])
}

model PriceScenario {
  id                        String              @id @default(uuid()) @db.Uuid
  bakeryId                  String              @db.Uuid
  calculationId             String              @db.Uuid
  name                      String              @db.VarChar(160)
  status                    PriceScenarioStatus @default(DRAFT)
  salePriceCUP              Decimal             @db.Decimal(18, 2)
  projectedQuantity         Decimal             @db.Decimal(18, 6)
  salePriceTaxTreatment     PriceTaxTreatment   @default(NOT_CONFIGURED)
  discountsReturnsCUP       Decimal             @default(0) @db.Decimal(18, 2)
  grossSalesCUP             Decimal?            @db.Decimal(18, 2)
  netSalesCUP               Decimal?            @db.Decimal(18, 2)
  costOfSalesCUP            Decimal?            @db.Decimal(18, 2)
  otherOperatingExpensesCUP Decimal?            @db.Decimal(18, 2)
  salesTaxCUP               Decimal?            @db.Decimal(18, 2)
  profitBeforeProfitTaxCUP  Decimal?            @db.Decimal(18, 2)
  profitTaxCUP              Decimal?            @db.Decimal(18, 2)
  profitAfterTaxCUP         Decimal?            @db.Decimal(18, 2)
  netMarginPercent          Decimal?            @db.Decimal(9, 4)
  calculationSnapshot       Json?
  createdAt                 DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime            @updatedAt @db.Timestamptz(6)

  bakery      Bakery            @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  calculation CostCalculation   @relation(fields: [calculationId, bakeryId], references: [id, bakeryId], onDelete: Restrict)
  taxLines    ScenarioTaxLine[]

  @@unique([id, bakeryId])
  @@index([bakeryId, calculationId, createdAt])
  @@index([bakeryId, status, createdAt])
}

model ScenarioTaxLine {
  id                         String                    @id @default(uuid()) @db.Uuid
  bakeryId                   String                    @db.Uuid
  scenarioId                 String                    @db.Uuid
  bakeryTaxRuleId            String                    @db.Uuid
  taxRuleVersionId           String                    @db.Uuid
  taxNameSnapshot            String                    @db.VarChar(180)
  taxBaseSnapshot            TaxBase
  baseAmountCUP              Decimal?                  @db.Decimal(18, 2)
  rateApplied                Decimal?                  @db.Decimal(9, 6)
  taxAmountCUP               Decimal?                  @db.Decimal(18, 2)
  verificationStatusSnapshot TaxRuleVerificationStatus
  notesSnapshot              String?                   @db.Text

  scenario      PriceScenario @relation(fields: [scenarioId, bakeryId], references: [id, bakeryId], onDelete: Restrict)
  bakeryTaxRule BakeryTaxRule @relation(fields: [bakeryTaxRuleId, bakeryId, taxRuleVersionId], references: [id, bakeryId, taxRuleVersionId], onDelete: Restrict)

  @@unique([scenarioId, bakeryTaxRuleId])
  @@index([bakeryId, scenarioId])
}
