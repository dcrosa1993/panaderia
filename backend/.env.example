# Copy this file to backend/.env and replace the placeholder with the value
# of POSTGRES_PASSWORD in infra/.env. Never commit a real .env file.
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
JWT_SECRET=replace-with-at-least-32-random-bytes-before-startup
# Set these values only when explicitly running npm run bootstrap:admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_BAKERY_NAME=
DATABASE_URL="postgresql://panaderia_app:REPLACE_WITH_INFRA_ENV_PASSWORD@localhost:5433/panaderia?schema=public"
